#!/bin/sh
# lightmem -- 光明记忆（LIMS）内核服务
#
# PROVIDE: lightmem
# REQUIRE: NETWORKING
# KEYWORD: shutdown
#
# 在 /etc/rc.conf 中至少需要：
#   lightmem_enable="YES"
#   lightmem_chdir="/usr/local/lightmem"
#   lightmem_user="workbuddy"
#
# 可选（默认值见下）：
#   lightmem_profile="/usr/local/lightmem/profiles/lims-family.profile.yaml"
#   lightmem_listen=":18443"
#   lightmem_embedder="hash"
#   lightmem_pg_host="10.0.10.10"    # lims-pg jail
#   lightmem_pg_port="5432"
#   lightmem_pg_user="lightmem_app"  # R28：非 superuser 运行角色（禁再用 postgres）
#   lightmem_pg_db="lims_dsh"        # 专用库，勿用 lims（同机有其它测试）
#   lightmem_pg_secrets="/var/db/lightmem/pg_app.env"
#                                   # R28：PG 口令从该文件注入（chmod 600）。
#                                   # rc.conf 里**不写明文口令**；kernel 的
#                                   # resolveSecrets 读 LIMS_PG_PASSWORD 覆盖 profile。
#   lightmem_log="/var/log/lightmem.log"
#   lightmem_pidfile="/var/run/lightmem/lightmem.pid"
#   lightmem_pg_wait="60"            # 启动前等待 PG 就绪的秒数
#   lightmem_restart_delay="5"       # R29-A：崩溃后重启延迟秒数（daemon -R）
#   lightmem_restart_count="24"      # R29-A：最多重启次数（daemon -C；用尽后
#                                    # daemon 自行退出 → 服务真下线，防无限刷屏）
#
# 设计说明：
#   1. 默认走 **pgvector 档**（持久化）。Solo/SQLite 档自 R19-B 起为**真实磁盘
#      持久化**（modernc.org/sqlite 纯 Go 驱动：写入→关闭→重开数据仍在，见
#      backend_sqlite_persist_test.go）；旧注释「内存骨架、重启即丢数据」已过时
#      （_R160 问题记录 I-15 已闭环）。
#   2. 端口 18443 刻意避开机器上既有的 :8443 旧实例，互不影响。
#   3. 停止时按「本服务的二进制 + profile」精确匹配，绝不误杀 :8443 旧实例。
#   4. 启动前等待 lims-pg jail 的 5432 就绪，避免开机竞态导致后端连接失败。
#   5. R29-A（永续运行 L1）：daemon(8) 以 **-R/-C** 监督重启（0.88 实测支持），
#      崩溃自愈 + 有界防抖；stop 顺序为「先 TERM 监督者 → 等待 → 兜底 pkill」。
#      依据 daemon(8) 手册：SIGTERM 发给监督者会转发给子进程，子进程退出、
#      移除 pidfile、监督者随后终止；若先杀子进程，监督者会立刻拉起新子进程，
#      与随后的 TERM 竞态，可能留下新实例占用端口（下次 start 报 EADDRINUSE）。

. /etc/rc.subr

name="lightmem"
rcvar="lightmem_enable"
desc="lightmem (光明记忆) memory kernel"

load_rc_config $name

: ${lightmem_enable:="NO"}
: ${lightmem_chdir:="/usr/local/lightmem"}
: ${lightmem_user:="workbuddy"}
: ${lightmem_binary:="${lightmem_chdir}/lightmem-kernel"}
: ${lightmem_profile:="${lightmem_chdir}/profiles/lims-family.profile.yaml"}
: ${lightmem_listen:=":18443"}
: ${lightmem_embedder:="hash"}
: ${lightmem_pg_host:="10.0.10.10"}
: ${lightmem_pg_port:="5432"}
: ${lightmem_pg_user:="postgres"}
: ${lightmem_pg_db:="lims_dsh"}
# R28（认证收紧）：PG 口令只从 secrets 文件读，rc.conf 保持无明文。
: ${lightmem_pg_secrets:="/var/db/lightmem/pg_app.env"}
: ${lightmem_log:="/var/log/lightmem.log"}
: ${lightmem_pidfile:="/var/run/lightmem/lightmem.pid"}
: ${lightmem_pg_wait:="60"}
: ${lightmem_start_wait:="20"}
# R29-A：daemon(8) 监督重启参数（0.88 `man daemon` 实测支持 -R/-C/-H）。
#   -R <秒>：子进程终止后延迟 N 秒重启（1–31536000）——把崩溃风暴压成
#            「每 N 秒最多一次」的有界节奏；
#   -C <N>：最多重启 N 次，用尽后 daemon 自身退出 → 服务真下线（看日志喊人），
#           而非无限刷屏；此时由 watchdog（deploy/ 三件套，T0 P0-A 交付）
#           作为最后一道兜底重新拉起并告警；
#   -H    ：收到 SIGHUP 时重开 -o 日志文件，配合 deploy/newsyslog.d/lightmem.conf
#           （T0 P0-A 交付）做日志轮转，避免长期运行撑满盘（L-257）。
: ${lightmem_restart_delay:="5"}
: ${lightmem_restart_count:="24"}
# R21 T3：agent token 表（供 AuthMiddleware 鉴权）。文件不存在 → 不注入 → 透传态。
: ${lightmem_tokens_file:="${lightmem_chdir}/agent-tokens.json"}

# --- 用户与 HOME -----------------------------------------------------------
# 不要给 daemon(8) 传 -u：当 ${name}_user 被设置时，rc.subr 自己已经通过
#     limits -C <class> su -m ${user} -c 'sh -c "<command> <command_args>"'
# 完成了降权。再让 daemon(8) 切一次用户会令 setusercontext(3) 失败
# （此时已非 root，无法 initgroups/setgid），服务会静默起不来。
# `su -m` 保留调用者环境，所以 HOME 必须显式钉住。
: ${lightmem_home:=""}
if [ -z "$lightmem_home" ] && [ -n "$lightmem_user" ]; then
    lightmem_home=$(eval echo "~${lightmem_user}" 2>/dev/null)
fi
# LIMS_PG_* 由 kernel 的 resolveSecrets 读取，用于覆盖 profile 里的连接串。
# R28：口令取自 secrets 文件（见 lightmem_pg_secrets），文件缺失则以空口令启动
# ——在 pg_hba 已收紧为 scram-sha-256 的前提下，空口令会连接失败并显式报错，
#   绝不静默退回免密（trust 已从 host 规则中移除）。
lightmem_pg_password=""
if [ -f "$lightmem_pg_secrets" ]; then
    . "$lightmem_pg_secrets"
    lightmem_pg_password="${LIMS_PG_PASSWORD:-}"
fi
: ${lightmem_env:="HOME=${lightmem_home} LIMS_PG_HOST=${lightmem_pg_host} LIMS_PG_PORT=${lightmem_pg_port} LIMS_PG_USER=${lightmem_pg_user} LIMS_PG_DB=${lightmem_pg_db} LIMS_PG_PASSWORD=${lightmem_pg_password}"}

pidfile="${lightmem_pidfile}"
# 注意：**不能**把 /usr/sbin/daemon 当作 rc.subr 的 command。
# 本版 FreeBSD 的 daemon(8) 是「前台监管」：它会一直等到子进程退出才返回
# （实测 `daemon -P p -o log /bin/sleep 30` 会阻塞 30s）。rc.subr 对 command
# 是前台等待，于是 `service lightmem start` 会永久挂住。
# 正确做法：用自定义 start_cmd 显式后台化（见 lightmem_start）。
# command 仅作为 rc.subr 的元信息与 required_files 校验用。
command="${lightmem_binary}"
procname="${lightmem_binary}"
required_dirs="${lightmem_chdir}"
required_files="${lightmem_binary} ${lightmem_profile}"

# 仅匹配本服务的进程（含完整二进制路径与 profile），
# 避免误杀同机上其它 lightmem 实例（例如 :8443 的旧实例）。
lightmem_pkill_pattern="${lightmem_binary} -profile ${lightmem_profile}"

lightmem_group() {
    id -g "${lightmem_user}" 2>/dev/null || echo wheel
}

lightmem_precmd() {
    # pidfile 由以 ${lightmem_user} 身份运行的 daemon(8) 写入，目录须可写。
    lightmem_rundir=$(dirname "${pidfile}")
    if [ ! -d "${lightmem_rundir}" ]; then
        install -d -o "${lightmem_user}" -g "$(lightmem_group)" -m 755 "${lightmem_rundir}"
    fi
    # 日志同样以服务用户身份写入。
    if [ ! -f "${lightmem_log}" ]; then
        install -o "${lightmem_user}" -g "$(lightmem_group)" -m 644 /dev/null "${lightmem_log}"
    fi
    # 等待 lims-pg jail 的 PostgreSQL 就绪（开机竞态保护）。
    _i=0
    while [ "${_i}" -lt "${lightmem_pg_wait}" ]; do
        if nc -z -w 2 "${lightmem_pg_host}" "${lightmem_pg_port}" 2>/dev/null; then
            return 0
        fi
        _i=$((_i + 1))
        sleep 1
    done
    echo "lightmem: PostgreSQL ${lightmem_pg_host}:${lightmem_pg_port} 在 ${lightmem_pg_wait}s 内不可达" >&2
    return 1
}

# 停止 daemon(8) 监督者及其 lightmem-kernel 子进程。
# R29-A 顺序修正（v1.0 设计稿「现有顺序天然兼容」结论已作废）：
#   旧顺序先 pkill 子进程 → 在 -R/-C 监督语义下，监督者会**立刻**拉起新子进程，
#   随后 TERM 才到 → 竞态留下新实例占用端口 → 下次 start 报 EADDRINUSE。
#   新顺序依据 daemon(8) 手册（0.88 实测语义）：SIGTERM 发给**监督者**时它转发给
#   子进程，子进程退出、移除 pidfile、监督者随后终止 —— 一步到位、无竞态。
#     ① kill -TERM "$(cat ${pidfile})"      # 先 supervisor（-P 记录的就是它）
#     ② 轮询等待 supervisor 与子进程都消失（带超时）
#     ③ pkill -f "${lightmem_pkill_pattern}"  # 兜底：清孤儿（不再是首选）
#     ④ rm -f "${pidfile}"
lightmem_stop() {
    # 1) 先 TERM 监督者：它转发 TERM 给子进程、清 pidfile、自行退出。
    #    （-P 写的是 supervisor pid；若误用 -p 的子进程 pid，手册明确警告
    #     「signal the child → daemon restarts it」——正是要避免的竞态。）
    if [ -f "${pidfile}" ]; then
        kill -TERM "$(cat "${pidfile}")" 2>/dev/null
    fi
    # 2) 轮询等待 supervisor 与子进程都消失（最多 20s）。
    _i=0
    while [ "${_i}" -lt 20 ]; do
        _sup=""
        [ -f "${pidfile}" ] && _sup=$(cat "${pidfile}" 2>/dev/null)
        _alive=""
        [ -n "${_sup}" ] && kill -0 "${_sup}" 2>/dev/null && _alive="sup"
        pgrep -f "${lightmem_pkill_pattern}" >/dev/null 2>&1 && _alive="${_alive}child"
        [ -z "${_alive}" ] && break
        sleep 1
        _i=$((_i + 1))
    done
    # 3) 兜底：仍有残留（孤儿子进程/失联 pidfile）才强制清。
    if pgrep -f "${lightmem_pkill_pattern}" >/dev/null 2>&1; then
        echo "lightmem: 优雅退出超时，强制结束" >&2
        pkill -9 -f "${lightmem_pkill_pattern}" 2>/dev/null
        sleep 1
    fi
    # 4) pidfile 必须清掉：否则 daemon -P 会认为「process already running」而拒绝启动。
    rm -f "${pidfile}"
    return 0
}

# 判定是否在跑。以 **pidfile + kill -0** 为准（daemon(8) 监管进程），
# 命令行为辅。仅靠 pgrep -f 会漏判：daemon 监管进程的 cmdline 是
#     daemon: /usr/local/lightmem/lightmem-kernel[12345] (daemon)
# 不含 " -profile "，子进程 exec 完成前的短暂窗口也会漏判。
lightmem_status() {
    _sup=""
    [ -f "${pidfile}" ] && _sup=$(cat "${pidfile}" 2>/dev/null)
    _child=$(pgrep -f "${lightmem_pkill_pattern}" 2>/dev/null)

    if [ -n "${_sup}" ] && kill -0 "${_sup}" 2>/dev/null; then
        echo "lightmem is RUNNING on ${lightmem_listen} (supervisor pid ${_sup})"
    elif [ -n "${_child}" ]; then
        echo "lightmem is RUNNING on ${lightmem_listen} (pid ${_child})"
    else
        echo "lightmem is NOT running"
        return 1
    fi
    [ -n "${_child}" ] && echo "  kernel pid: $(echo "${_child}" | tr '\n' ' ')"
    # -T 5 必须有：fetch 默认没有超时，服务异常时会永久挂住 status。
    _health=$(fetch -q -T 5 -o - "http://127.0.0.1${lightmem_listen}/healthz" 2>/dev/null)
    [ -n "${_health}" ] && echo "  health: ${_health}"
    return 0
}

# 启动：显式后台化 daemon(8)，再等健康检查通过才返回。
# -f 让 daemon 先把 stdin/stdout/stderr 指向 /dev/null，再按 -o 写日志：
# 这样它不会继承调用方的任何 fd（否则非交互 SSH 会因管道被持有而一直不返回）。
# -H -R -C：R29-A 监督重启（崩溃自愈 + 有界防抖 + SIGHUP 重开日志），
# 详见上方 lightmem_restart_delay/lightmem_restart_count 注释。
lightmem_start() {
    rm -f "${pidfile}"
    # R21 T3：token 表由 install 脚本落到 ${lightmem_tokens_file}（0600）。
    # 缺失 → 不注入 LIMS_AGENT_TOKENS → AuthMiddleware 透传（开发阶段/零回归）。
    # 存在 → 业务端点需要 Bearer token；运维端点（/healthz、/metrics）豁免，
    # 故下面的健康检查仍能通过。
    _tokens=""
    if [ -r "${lightmem_tokens_file}" ]; then
        _tokens=$(cat "${lightmem_tokens_file}")
    fi
    # -u 必须显式给：自定义 start_cmd 走的是 rc.subr 的 *_cmd 分支，
    # 不会套用 ${name}_user 的 su 包装，否则服务会以 root 身份运行。
    if [ -n "${_tokens}" ]; then
        /usr/sbin/daemon -f -H -R "${lightmem_restart_delay}" -C "${lightmem_restart_count}" \
            -u "${lightmem_user}" -P "${pidfile}" -o "${lightmem_log}" \
            env "HOME=${lightmem_home}" \
                "LIMS_AGENT_TOKENS=${_tokens}" \
            "${lightmem_binary}" \
            -profile "${lightmem_profile}" \
            -listen "${lightmem_listen}" \
            -embedder "${lightmem_embedder}" &
    else
        /usr/sbin/daemon -f -H -R "${lightmem_restart_delay}" -C "${lightmem_restart_count}" \
            -u "${lightmem_user}" -P "${pidfile}" -o "${lightmem_log}" \
            env "HOME=${lightmem_home}" \
            "${lightmem_binary}" \
            -profile "${lightmem_profile}" \
            -listen "${lightmem_listen}" \
            -embedder "${lightmem_embedder}" &
    fi
    _i=0
    while [ "${_i}" -lt "${lightmem_start_wait}" ]; do
        if fetch -q -T 2 -o - "http://127.0.0.1${lightmem_listen}/healthz" >/dev/null 2>&1; then
            # daemon(8) 在降权前写 pidfile，故其属主是 root；放开读权限，
            # 便于排查时非 root 也能读到。
            [ -f "${pidfile}" ] && chmod 644 "${pidfile}" 2>/dev/null
            return 0
        fi
        _i=$((_i + 1))
        sleep 1
    done
    echo "lightmem: 启动后 ${lightmem_start_wait}s 内健康检查未通过" >&2
    return 1
}

start_precmd="lightmem_precmd"
start_cmd="lightmem_start"
stop_cmd="lightmem_stop"
status_cmd="lightmem_status"

run_rc_command "$1"
