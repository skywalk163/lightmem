{
  "name": "backup",
  "version": "1.0.0",
  "description": "ZFS 快照备份",
  "author": "lightmem",
  "trust": "official",
  "type": "service",
  "entrypoint": "bin/backup",
  "config": {"pool": "tank", "retention_snapshots": 7, "schedule": "0 3 * * *"},
  "permissions": ["zfs:snapshot"],
  "memory_types": ["fact"],
  "dependencies": ["registry"]
}