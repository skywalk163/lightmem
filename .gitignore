# 北极星明细（体积大，不入库）
*.detail.jsonl

# 临时文件与构建产物
*.tmp
*.tmp*

# —— R21 接入套件：运行目录与凭据（**含明文 token，绝不入库**）——
# install.sh 的默认运行目录：token 表、SQLite 数据、日志、客户端接入包
_lightmem_run/
# 令牌/凭据类文件（无论放在哪都忽略）
agent-tokens.json
tokens.csv
clients/*-token.json
*-token.txt
.lightmem-secrets/
# 交叉编译产物体积大
.lightmem-bin/

# —— R23 前台服务 ——
# 运行时 SQLite 数据（凭据 + 会话日志）不入库
data/
# 本地编译产物（0.88 上 go build 输出，跨平台不入库）
kernel/lightmem-kernel
kernel/lightmem-mcp
kernel/lightmem-frontend
# gate.sh 每次运行产生的门禁报告
eval/reports/
# 会话临时 scratch
.tmp/
